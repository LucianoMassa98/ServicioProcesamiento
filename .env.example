# Variables de entorno del servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (única URL de conexión)
DATABASE_URL=postgresql://usuario:password@host:5432/database

# Configuración de subida de archivos
MAX_FILE_SIZE_MB=500

# ─── Configuración del algoritmo de conteo de huevos (OpenCV) ────────────────
# Binario de Python a usar ('python3' en Linux/Mac, 'python' en Windows)
PYTHON_BIN=python3

# Posición de la línea de conteo como fracción del alto del frame (0.0 a 1.0)
# 0.65 = línea a 65% del alto (recomendado para cinta top→bottom)
EGG_COUNTING_LINE_RATIO=0.65

# Área mínima y máxima (px²) de un contorno para ser considerado huevo
# Ajustar según la resolución de la cámara y el tamaño aparente del huevo
EGG_MIN_AREA=600
EGG_MAX_AREA=18000

# Procesar 1 de cada N frames (mejora rendimiento; 2 = mitad de frames)
EGG_PROCESS_EVERY_N_FRAMES=2

# Distancia máxima (px) entre dos centroides en frames consecutivos
# para considerar que pertenecen al mismo huevo
EGG_MAX_CENTROID_DIST=90

# Mínimo de frames que un huevo debe estar rastreado antes de contar
# (evita contar ruido o detecciones fugaces)
EGG_MIN_TRACK_FRAMES=4

# Frames sin detección antes de eliminar un track (tolerancia a oclusión)
EGG_MAX_LOST_FRAMES=10

