# Variables de entorno del servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (única URL de conexión)
DATABASE_URL=postgresql://usuario:password@host:5432/database

# Configuración de subida de archivos
MAX_FILE_SIZE_MB=500

# ─── Configuración del algoritmo de conteo de huevos (OpenCV) ────────────────
# Binario de Python a usar ('python3' en Linux/Mac, 'python' en Windows)
PYTHON_BIN=python3

# Posición de la línea de conteo como fracción del alto del frame (0.0 a 1.0)
EGG_COUNTING_LINE_RATIO=0.65

# Área mínima y máxima (px²) de un contorno para ser considerado huevo
# Calibrado para cámara 276x480: min=150 da 81/82 huevos (98.8% precisión)
# Para cámara 640x480 con huevos más grandes, usar min=600
EGG_MIN_AREA=150
EGG_MAX_AREA=12000

# Procesar 1 de cada N frames (2 = mitad de frames, mejor rendimiento)
EGG_PROCESS_EVERY_N_FRAMES=2

# Distancia máxima (px) entre centroides consecutivos del mismo huevo
EGG_MAX_CENTROID_DIST=90

# Frames mínimos rastreados antes de contar (1 = más sensible, 3 = más estricto)
EGG_MIN_TRACK_FRAMES=1

# Frames sin detección antes de eliminar un track
EGG_MAX_LOST_FRAMES=10

# Fracción del ancho del frame a analizar (1.0 = frame completo)
# Usar 0.65 si hay paredes/objetos fijos en el lado derecho del encuadre
EGG_ROI_WIDTH_RATIO=1.0

